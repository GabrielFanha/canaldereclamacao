Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|phar|cgi|pl|asp|aspx|shtml|js|html?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>